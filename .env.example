# ==========================================
# G4 Sticker — Environment Configuration
# ==========================================

# ------------------------------------------
# Runtime Variables (Server / Express)
# Read dynamically by Node.js at runtime
# ------------------------------------------

# [Runtime] Port the Express server listens on (cloud hosts like Render/Heroku provide PORT automatically)
PORT=4000

# [Runtime] MongoDB Atlas connection URI or local MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/business-hub

# [Runtime] Secret key for HMAC signing session cookies and reset tokens (must be random and at least 32 characters)
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# [Runtime] Set to "true" in production with HTTPS so session cookies are marked Secure; "false" for local HTTP
COOKIE_SECURE=false

# [Runtime] Allowed CORS origin(s), comma-separated. In single-service deployment, set to your deployed public domain (e.g. https://your-domain.com)
CLIENT_URL=http://localhost:5173

# [Runtime] Google OAuth 2.0 Web Client ID used by the backend to verify ID tokens upon sign-in
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com

# [Runtime] Gmail address used by Nodemailer to send password reset code emails
MAIL_USER=your-sender@gmail.com

# [Runtime] 16-character Gmail App Password (requires 2-Step Verification enabled on the Gmail account)
MAIL_APP_PASSWORD=your-16-character-gmail-app-password

# [Runtime] (Optional) Sender display name and address for password reset emails (defaults to "G4 Sticker <MAIL_USER>")
MAIL_FROM=G4 Sticker <your-sender@gmail.com>

# ------------------------------------------
# Build-time Variables (Frontend / Vite)
# Embedded into the client bundle during "npm run build"
# ------------------------------------------

# [Build-time] Google OAuth 2.0 Web Client ID injected into the client bundle for Google Sign-In (must match GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
